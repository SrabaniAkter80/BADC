<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom, #f8fafc, #e2e8f0);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group3.badc.Srabani_Akter.Farmer.G8_Farmer_Delivery_ConfirmationController">

    <children>

        <!-- Title -->
        <Label fx:id="DeleveryInformationLabel" alignment="CENTER" layoutX="250.0" layoutY="30.0" prefWidth="400.0" style="-fx-font-size:28px;                     -fx-font-weight:bold;                     -fx-text-fill:#1E3A8A;" text="Delivery Confirmation" />

        <!-- Order ID -->
        <Text layoutX="220.0" layoutY="120.0" style="-fx-font-size:15px;                    -fx-font-weight:bold;                    -fx-fill:#374151;" text="Order ID" />

        <TextField fx:id="FilterOrderIDtextField" layoutX="310.0" layoutY="95.0" prefHeight="40.0" prefWidth="220.0" promptText="Enter Order ID" style="-fx-background-radius:10;                         -fx-border-radius:10;                         -fx-border-color:#CBD5E1;                         -fx-font-size:14px;" />

        <!-- Confirm Button -->
        <Button layoutX="560.0" layoutY="95.0" mnemonicParsing="false" onAction="#handleLoadDataButton" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color:#10B981;                      -fx-text-fill:white;                      -fx-font-size:14px;                      -fx-font-weight:bold;                      -fx-background-radius:10;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(16,185,129,0.35),12,0,0,4);" text="Confirm Delivery" />

        <!-- Confirmation Message -->
        <Label fx:id="confirmationMessageLabel" alignment="CENTER" layoutX="262.0" layoutY="162.0" prefWidth="400.0" style="-fx-font-size:16px;                     -fx-font-weight:bold;                     -fx-text-fill:#16A34A;" text="Confirmation Message" />

        <!-- Table -->
        <TableView fx:id="DeleveryConfirmation_TableView" layoutX="107.0" layoutY="203.0" prefHeight="280.0" prefWidth="646.0" style="-fx-background-radius:12;                         -fx-border-radius:12;                         -fx-border-color:#CBD5E1;                         -fx-font-size:14px;">

            <columns>

                <TableColumn fx:id="orderIDColumn" prefWidth="219.20001983642578" text="Order ID" />

                <TableColumn fx:id="productNameColumn" prefWidth="240.80001831054688" text="Product Name" />

                <TableColumn fx:id="deleveryStatusColumn" prefWidth="240.0" text="Delivery Status" />

            </columns>

        </TableView>

        <!-- Back Button -->
        <Button layoutX="250.0" layoutY="516.0" mnemonicParsing="false" onAction="#handleBacktoDashboardButton" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color:#374151;                      -fx-text-fill:white;                      -fx-font-size:15px;                      -fx-font-weight:bold;                      -fx-background-radius:12;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(55,65,81,0.35),12,0,0,4);" text="Back to Dashboard" />

    </children>
</AnchorPane>
