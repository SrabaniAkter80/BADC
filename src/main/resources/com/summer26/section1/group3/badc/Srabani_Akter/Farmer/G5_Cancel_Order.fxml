<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom, #f8fafc, #e2e8f0);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group3.badc.Srabani_Akter.Farmer.G5_Cancel_OrderController">

    <children>

        <!-- Title -->
        <Label fx:id="myOrdersLabel" alignment="CENTER" layoutX="300.0" layoutY="30.0" prefWidth="300.0" style="-fx-font-size:28px;                     -fx-font-weight:bold;                     -fx-text-fill:#1E3A8A;" text="My Orders" />

        <!-- Order ID -->
        <Text layoutX="220.0" layoutY="120.0" style="-fx-font-size:15px;                    -fx-font-weight:bold;                    -fx-fill:#374151;" text="Order ID" />

        <TextField fx:id="filterOrderIDTextField" layoutX="320.0" layoutY="95.0" prefHeight="40.0" prefWidth="220.0" promptText="Enter Order ID" style="-fx-background-radius:10;                         -fx-border-radius:10;                         -fx-border-color:#CBD5E1;                         -fx-font-size:14px;" />

        <!-- Cancel Button -->
        <Button layoutX="561.0" layoutY="144.0" mnemonicParsing="false" onAction="#HandleCancelOrderButton" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color:#EF4444;                      -fx-text-fill:white;                      -fx-font-size:14px;                      -fx-font-weight:bold;                      -fx-background-radius:10;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(239,68,68,0.35),12,0,0,4);" text="Cancel Order" />

        <!-- Confirmation -->
        <Label fx:id="confirmationMessageLabel" alignment="CENTER" layoutX="68.0" layoutY="507.0" prefWidth="400.0" style="-fx-font-size:16px;                     -fx-font-weight:bold;                     -fx-text-fill:#16A34A;" text="Confirmation Message" />

        <!-- Table -->
        <TableView fx:id="CancelOrder_TableView" layoutX="36.0" layoutY="212.0" prefHeight="280.0" prefWidth="660.0" style="-fx-background-radius:12;                         -fx-border-radius:12;                         -fx-border-color:#CBD5E1;                         -fx-font-size:14px;">

            <columns>

                <TableColumn fx:id="orderIDColumn" prefWidth="180.0" text="Order ID" />

                <TableColumn fx:id="ProductNameColumn" prefWidth="260.0" text="Product Name" />

                <TableColumn fx:id="quantityColumn" prefWidth="220.0" text="Quantity" />

            </columns>

        </TableView>

        <!-- Back Button -->
        <Button layoutX="460.0" layoutY="533.0" mnemonicParsing="false" onAction="#HandleBacktoDashboardButton" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color:#374151;                      -fx-text-fill:white;                      -fx-font-size:15px;                      -fx-font-weight:bold;                      -fx-background-radius:12;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(55,65,81,0.35),12,0,0,4);" text="Back to Dashboard" />

    </children>
</AnchorPane>
