<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="628.0" prefWidth="821.0" style="-fx-background-color: linear-gradient(to bottom, #f8fafc, #e2e8f0);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group3.badc.Srabani_Akter.HR_Manager.G1_Employee_Info_ViewController">

    <children>

        <!-- Title -->
        <Label fx:id="EmployeeDirectoryLabel" alignment="CENTER" layoutX="194.0" layoutY="28.0" prefWidth="400.0" style="-fx-font-size:28px;                     -fx-font-weight:bold;                     -fx-text-fill:#1E3A8A;" text=" Employee Directory" />

        <!-- Employee ID -->
        <Text layoutX="164.0" layoutY="131.0" style="-fx-font-size:15px;                    -fx-font-weight:bold;                    -fx-fill:#374151;" text="Employee ID" />

        <!-- Search Button -->
        <Button layoutX="540.0" layoutY="95.0" mnemonicParsing="false" onAction="#HandleSearchFilterButton" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color:#2563EB;                      -fx-text-fill:white;                      -fx-font-size:14px;                      -fx-font-weight:bold;                      -fx-background-radius:10;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(37,99,235,0.35),12,0,0,4);" text=" Search" />

        <!-- View All -->
        <Button layoutX="374.0" layoutY="211.0" mnemonicParsing="false" onAction="#HandleViewAllEmployeesButton" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color:#10B981;                      -fx-text-fill:white;                      -fx-font-size:14px;                      -fx-font-weight:bold;                      -fx-background-radius:10;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(16,185,129,0.35),12,0,0,4);" text="View All Employees" />

        <!-- Employee Table -->
        <TableView fx:id="Employee_Information_TableView" layoutX="38.0" layoutY="269.0" prefHeight="280.0" prefWidth="710.0" style="-fx-background-radius:12;                         -fx-border-radius:12;                         -fx-border-color:#CBD5E1;                         -fx-font-size:14px;">

            <columns>

                <TableColumn fx:id="EmployeeIDColumn" prefWidth="176.80004119873047" text="Employee ID" />

                <TableColumn fx:id="NameColumn" prefWidth="164.7999267578125" text="Name" />

                <TableColumn fx:id="DesignationColumn" prefWidth="180.0" text="Designation" />

                <TableColumn fx:id="ContactInformationColumn" prefWidth="220.0" text="Contact Information" />

            </columns>

        </TableView>

        <!-- Back -->
        <Button layoutX="320.0" layoutY="557.0" mnemonicParsing="false" onAction="#HandleBackToDashBoardButton" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color:#374151;                      -fx-text-fill:white;                      -fx-font-size:15px;                      -fx-font-weight:bold;                      -fx-background-radius:12;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(55,65,81,0.35),12,0,0,4);" text="Back to Dashboard" />
      <ComboBox fx:id="DesignationComboBox" layoutX="304.0" layoutY="150.0" prefHeight="26.0" prefWidth="166.0" promptText="Select a Designation" />
      <TextField fx:id="FilterEmployeeIDTextField" layoutX="272.0" layoutY="113.0" />

    </children>
</AnchorPane>
