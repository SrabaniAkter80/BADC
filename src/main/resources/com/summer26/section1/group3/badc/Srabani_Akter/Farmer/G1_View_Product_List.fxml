<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom, #f8fafc, #e2e8f0);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group3.badc.Srabani_Akter.Farmer.G1_View_Product_ListController">

    <children>

        <!-- Title -->
        <Label fx:id="productListLabel" alignment="CENTER" layoutX="340.0" layoutY="30.0" prefWidth="220.0" style="-fx-font-size:28px;                     -fx-font-weight:bold;                     -fx-text-fill:#1E3A8A;" text="Product List" />

        <!-- Search Label -->
        <Text layoutX="180.0" layoutY="120.0" style="-fx-font-size:15px;                    -fx-font-weight:bold;                    -fx-fill:#374151;" text="Product Name" />

        <!-- Search Field -->
        <TextField fx:id="FilterProductNameTextField" layoutX="300.0" layoutY="95.0" prefHeight="38.0" prefWidth="280.0" promptText="Enter product name..." style="-fx-background-radius:10;                         -fx-font-size:14px;                         -fx-border-radius:10;                         -fx-border-color:#CBD5E1;" />

        <!-- Search Button -->
        <Button layoutX="655.0" layoutY="75.0" mnemonicParsing="false" onAction="#HandleSearchFilterButton" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color:#2563EB;                      -fx-text-fill:white;                      -fx-font-size:14px;                      -fx-font-weight:bold;                      -fx-background-radius:10;                      -fx-cursor:hand;" text="Search Filter" />

        <!-- Reset Button -->
        <Button layoutX="505.0" layoutY="155.0" mnemonicParsing="false" onAction="#HandleResetFilter" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color:#F59E0B;                      -fx-text-fill:white;                      -fx-font-size:14px;                      -fx-font-weight:bold;                      -fx-background-radius:10;                      -fx-cursor:hand;" text="Reset Filter" />

        <!-- Product Table -->
        <TableView fx:id="Product_List_TableView" layoutX="120.0" layoutY="230.0" prefHeight="280.0" prefWidth="660.0" style="-fx-background-radius:12;                         -fx-border-radius:12;                         -fx-border-color:#CBD5E1;                         -fx-font-size:14px;">

            <columns>
                <TableColumn fx:id="ProductNameColumn" prefWidth="220.0" text="Product Name" />

                <TableColumn fx:id="ProductQuantityColumn" prefWidth="220.0" text="Product Quantity" />

                <TableColumn fx:id="availabilityStatusColumn" prefWidth="220.0" text="Available Status" />
            </columns>

        </TableView>

        <!-- Back Button -->
        <Button layoutX="340.0" layoutY="535.0" mnemonicParsing="false" onAction="#HandleBackToDashboardButton" prefHeight="42.0" prefWidth="220.0" style="-fx-background-color:#374151;                      -fx-text-fill:white;                      -fx-font-size:15px;                      -fx-font-weight:bold;                      -fx-background-radius:12;                      -fx-cursor:hand;" text="Back to Dashboard" />
      <ComboBox fx:id="ProductCategoryComboBox" layoutX="224.0" layoutY="162.0" prefWidth="150.0" promptText="Select a Product Category" />

    </children>
</AnchorPane>
