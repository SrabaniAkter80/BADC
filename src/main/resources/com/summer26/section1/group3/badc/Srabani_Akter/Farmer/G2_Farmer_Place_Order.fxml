<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom, #f8fafc, #e2e8f0);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group3.badc.Srabani_Akter.Farmer.G2_Farmer_Place_OrderController">

    <children>

        <!-- Title -->
        <Label fx:id="placeOrderPageLabel" alignment="CENTER" layoutX="300.0" layoutY="35.0" prefWidth="300.0" style="-fx-font-size:28px;                     -fx-font-weight:bold;                     -fx-text-fill:#1E3A8A;" text="Place Order" />

        <!-- Product -->
        <Text layoutX="250.0" layoutY="145.0" style="-fx-font-size:15px;                    -fx-font-weight:bold;                    -fx-fill:#374151;" text="Product" />

        <ComboBox fx:id="productCategoryComboBox" layoutX="350.0" layoutY="120.0" prefHeight="40.0" prefWidth="240.0" promptText="Select a product" style="-fx-background-radius:10;                        -fx-font-size:14px;" />

        <!-- Quantity -->
        <Text layoutX="250.0" layoutY="215.0" style="-fx-font-size:15px;                    -fx-font-weight:bold;                    -fx-fill:#374151;" text="Quantity" />

        <TextField fx:id="quantityTextField" layoutX="350.0" layoutY="190.0" prefHeight="40.0" prefWidth="240.0" promptText="Enter quantity" style="-fx-background-radius:10;                         -fx-border-radius:10;                         -fx-border-color:#CBD5E1;                         -fx-font-size:14px;" />

        <!-- Place Order -->
        <Button layoutX="350.0" layoutY="270.0" mnemonicParsing="false" onAction="#HandlePlaceOrderButton" prefHeight="45.0" prefWidth="240.0" style="-fx-background-color:#10B981;                      -fx-text-fill:white;                      -fx-font-size:15px;                      -fx-font-weight:bold;                      -fx-background-radius:12;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(16,185,129,0.35),12,0,0,4);" text="Place Order" />

        <!-- Confirmation -->
        <Label fx:id="confirmationMessageLabel" alignment="CENTER" layoutX="250.0" layoutY="340.0" prefWidth="400.0" style="-fx-font-size:16px;                     -fx-font-weight:bold;                     -fx-text-fill:#16A34A;" text="Confirmation Message" />

        <!-- Back -->
        <Button layoutX="350.0" layoutY="430.0" mnemonicParsing="false" onAction="#HandleBackToDashboardButton" prefHeight="45.0" prefWidth="240.0" style="-fx-background-color:#374151;                      -fx-text-fill:white;                      -fx-font-size:15px;                      -fx-font-weight:bold;                      -fx-background-radius:12;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(55,65,81,0.35),12,0,0,4);" text="Back to Dashboard" />

    </children>
</AnchorPane>
