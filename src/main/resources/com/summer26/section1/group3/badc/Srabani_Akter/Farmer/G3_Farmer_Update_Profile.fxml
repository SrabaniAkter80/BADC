<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom, #f8fafc, #e2e8f0);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group3.badc.Srabani_Akter.Farmer.G3_Farmer_Update_ProfileController">

    <children>

        <!-- Title -->
        <Label fx:id="updateProfilePageLabel" alignment="CENTER" layoutX="275.0" layoutY="35.0" prefWidth="350.0" style="-fx-font-size:28px;                     -fx-font-weight:bold;                     -fx-text-fill:#1E3A8A;" text="Update Profile" />

        <!-- Name -->
        <Text layoutX="220.0" layoutY="135.0" style="-fx-font-size:15px;                    -fx-font-weight:bold;                    -fx-fill:#374151;" text="Name" />

        <TextField fx:id="NameTextField" layoutX="350.0" layoutY="110.0" prefHeight="40.0" prefWidth="280.0" promptText="Enter your name" style="-fx-background-radius:10;                         -fx-border-radius:10;                         -fx-border-color:#CBD5E1;                         -fx-font-size:14px;" />

        <!-- Phone -->
        <Text layoutX="220.0" layoutY="195.0" style="-fx-font-size:15px;                    -fx-font-weight:bold;                    -fx-fill:#374151;" text="Phone Number" />

        <TextField fx:id="PhoneNumberTextField" layoutX="350.0" layoutY="170.0" prefHeight="40.0" prefWidth="280.0" promptText="Enter phone number" style="-fx-background-radius:10;                         -fx-border-radius:10;                         -fx-border-color:#CBD5E1;                         -fx-font-size:14px;" />

        <!-- Address -->
        <Text layoutX="220.0" layoutY="260.0" style="-fx-font-size:15px;                    -fx-font-weight:bold;                    -fx-fill:#374151;" text="Address" />

        <TextArea fx:id="addressTextArea" layoutX="350.0" layoutY="230.0" prefHeight="90.0" prefWidth="280.0" promptText="Enter your address" style="-fx-background-radius:10;                        -fx-border-radius:10;                        -fx-border-color:#CBD5E1;                        -fx-font-size:14px;" />

        <!-- Update Button -->
        <Button layoutX="350.0" layoutY="350.0" mnemonicParsing="false" onAction="#HandleUpdateInformationButton" prefHeight="45.0" prefWidth="280.0" style="-fx-background-color:#2563EB;                      -fx-text-fill:white;                      -fx-font-size:15px;                      -fx-font-weight:bold;                      -fx-background-radius:12;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(37,99,235,0.35),12,0,0,4);" text="Update Information" />

        <!-- Confirmation -->
        <Label fx:id="confirmationMessageLabel" alignment="CENTER" layoutX="250.0" layoutY="420.0" prefWidth="400.0" style="-fx-font-size:16px;                     -fx-font-weight:bold;                     -fx-text-fill:#16A34A;" text="Confirmation Message" />

        <!-- Back -->
        <Button layoutX="350.0" layoutY="485.0" mnemonicParsing="false" onAction="#HandleBacktoDashBoardButton" prefHeight="45.0" prefWidth="280.0" style="-fx-background-color:#374151;                      -fx-text-fill:white;                      -fx-font-size:15px;                      -fx-font-weight:bold;                      -fx-background-radius:12;                      -fx-cursor:hand;                      -fx-effect:dropshadow(gaussian, rgba(55,65,81,0.35),12,0,0,4);" text="Back to Dashboard" />

    </children>
</AnchorPane>
