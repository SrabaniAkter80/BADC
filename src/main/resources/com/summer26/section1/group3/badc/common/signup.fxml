<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="423.0" prefWidth="522.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group3.badc.common.SignupController">
    <children>
        <Label layoutX="156.0" layoutY="22.0" prefHeight="52.0" prefWidth="210.0" text="Create An Account">
            <font>
                <Font name="Times New Roman Bold" size="24.0" />
            </font>
        </Label>
        <TextField fx:id="username" layoutX="66.0" layoutY="92.0" prefHeight="45.0" prefWidth="393.0" promptText="Username">
            <font>
                <Font name="Times New Roman" size="14.0" />
            </font>
        </TextField>
        <ComboBox fx:id="role" layoutX="66.0" layoutY="260.0" prefHeight="32.0" prefWidth="393.0" promptText="Select Role" />
        <TextField fx:id="password" layoutX="66.0" layoutY="149.0" prefHeight="45.0" prefWidth="393.0" promptText="Password">
            <font>
                <Font name="Times New Roman" size="14.0" />
            </font>
        </TextField>
        <TextField fx:id="confirmpassword" layoutX="66.0" layoutY="206.0" prefHeight="45.0" prefWidth="393.0" promptText="Confirm Password">
            <font>
                <Font name="Times New Roman" size="14.0" />
            </font>
        </TextField>
        <Button layoutX="225.0" layoutY="311.0" mnemonicParsing="false" onAction="#signup" prefHeight="25.0" prefWidth="73.0" text="Sign Up" />
        <Label fx:id="label" layoutX="95.0" layoutY="345.0" prefHeight="32.0" prefWidth="336.0" />
        <Hyperlink layoutX="173.0" layoutY="377.0" onAction="#loginlink" text="Already have an account? Login" />
    </children>
</AnchorPane>