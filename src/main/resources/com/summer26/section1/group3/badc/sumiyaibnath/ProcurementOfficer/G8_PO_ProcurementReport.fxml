            <Font name="Times New Roman Bold" size="24.0" />
         </font>
      </Label>
      <ComboBox fx:id="product" layoutX="38.0" layoutY="72.0" prefHeight="25.0" prefWidth="174.0" promptText="Product Name" />
      <DatePicker fx:id="purchasedate" layoutX="38.0" layoutY="109.0" promptText="Purchase Date" />
